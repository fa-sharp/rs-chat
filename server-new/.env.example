# Server Configuration
RS_CHAT_HOST=127.0.0.1
RS_CHAT_PORT=8080

# Database
RS_CHAT_DATABASE_URL=postgres://postgres:postgres@localhost/postgres
DATABASE_URL=postgres://postgres:postgres@localhost/postgres

# Auth
RS_CHAT_COOKIE_KEY=  # hex secret >=32 bytes, e.g. `openssl rand --hex 32`

# Logging
RS_CHAT_LOG_LEVEL=info
RS_CHAT_REQUEST_ID_HEADER=x-request-id
